<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Economic Regulation Bingo</title>

<style>
body {
    font-family: Arial, sans-serif;
    background: #f4f6f8;
    margin: 0;
    padding: 20px;
    text-align: center;
}

h1 {
    color: #1b365d;
}

#bingo {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    max-width: 700px;
    margin: 20px auto;
}

.square {
    background: white;
    border: 2px solid #ccc;
    border-radius: 8px;
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    font-size: 14px;
    cursor: pointer;
    user-select: none;
    transition: all 0.2s ease;
}

.square:hover {
    border-color: #ff8200;
}

.square.selected {
    background: #ff8200;
    color: white;
    border-color: #ff8200;
}

.square.free {
    background: #1b365d;
    color: white;
    font-weight: bold;
}

button {
    margin-top: 20px;
    padding: 12px 20px;
    border: none;
    border-radius: 6px;
    background: #1b365d;
    color: white;
    cursor: pointer;
}

button:hover {
    background: #10233f;
}

#message {
    margin-top: 15px;
    font-weight: bold;
    font-size: 20px;
    color: green;
}
</style>
</head>

<body>

<h1>Economic Regulation Bingo</h1>
<p>Tap a square to mark it off.</p>

<div id="bingo"></div>

<button onclick="generateNewCard()">Generate New Card</button>

<div id="message"></div>

<script>

const acronyms = [
"NER",
"AER",
"ESB",
"AEMC",
"AEMO",
"RIT-D",
"RIT-T",
"DAPR",
"DAP",
"CAPEX",
"OPEX",
"TSS",
"STPIS",
"DMIS",
"NTCR",
"PTRM",
"AARR",
"MAR",
"F&A",
"DNSP",
"TNSP",
"RAB",
"WACC",
"X-Factor",
"CER",
"DER",
"ISP",
"RIN",
"LTCR",
"SAIDI",
"SAIFI",
"CESS",
"EBSS",
"FRC",
"AEC",
"SAPS",
"TUOS",
"DUOS",
"TUOS Pricing"
];

const CARD_SIZE = 25;
const STORAGE_KEY = "econRegBingo";

function shuffle(array) {
    let copy = [...array];

    for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
    }

    return copy;
}

function generateNewCard() {

    document.getElementById("message").textContent = "";

    const shuffled = shuffle(acronyms);
    const selected = shuffled.slice(0, 24);

    selected.splice(12, 0, "FREE");

    saveCard(selected);

    renderCard(selected);
}

function renderCard(card) {

    const board = document.getElementById("bingo");
    board.innerHTML = "";

    card.forEach((item, index) => {

        const square = document.createElement("div");

        square.className = "square";
        square.innerText = item;

        if (item === "FREE") {
            square.classList.add("free");
            square.classList.add("selected");
        }

        square.addEventListener("click", () => {

            if (item === "FREE") return;

            square.classList.toggle("selected");

            saveSelections();

            checkBingo();
        });

        board.appendChild(square);
    });

    restoreSelections();
}

function saveCard(card) {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
            card: card,
            selected: []
        })
    );
}

function saveSelections() {

    const squares = [...document.querySelectorAll(".square")];

    const selected = squares.map(
        square => square.classList.contains("selected")
    );

    const data = JSON.parse(localStorage.getItem(STORAGE_KEY));

    data.selected = selected;

    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
}

function restoreSelections() {

    const data = JSON.parse(localStorage.getItem(STORAGE_KEY));

    if (!data || !data.selected) return;

    const squares = [...document.querySelectorAll(".square")];

    squares.forEach((square, index) => {
        if (data.selected[index]) {
            square.classList.add("selected");
        }
    });
}

function checkBingo() {

    const squares = [...document.querySelectorAll(".square")]
        .map(square => square.classList.contains("selected"));

    const lines = [];

    for (let r = 0; r < 5; r++) {
        lines.push([0,1,2,3,4].map(c => r * 5 + c));
    }

    for (let c = 0; c < 5; c++) {
        lines.push([0,1,2,3,4].map(r => r * 5 + c));
    }

    lines.push([0,6,12,18,24]);
    lines.push([4,8,12,16,20]);

    const bingo = lines.some(
        line => line.every(index => squares[index])
    );

    if (bingo) {
        document.getElementById("message").textContent =
            "🎉 BINGO! 🎉";
    }
}

function loadCard() {

    const stored = JSON.parse(
        localStorage.getItem(STORAGE_KEY)
    );

    if (stored && stored.card) {
        renderCard(stored.card);
    } else {
        generateNewCard();
    }
}

loadCard();

</script>

</body>
</html>
